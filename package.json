{
  "name": "flatsql",
  "version": "3.12.1",
  "description": "One SQL engine for binary FlatBuffer streams: SDS QRP queries and results, SDS GJN geometry, persistent indexed storage, and one WASI threads artifact across hosts.",
  "type": "module",
  "main": "wasm/index.js",
  "types": "wasm/index.d.ts",
  "exports": {
    ".": {
      "types": "./wasm/index.d.ts",
      "import": "./wasm/index.js"
    },
    "./flatsql.wasm": "./wasm/flatsql.wasm",
    "./integrity.json": "./wasm/integrity.json"
  },
  "files": [
    "wasm/index.js",
    "wasm/index.d.ts",
    "wasm/flatsql.wasm",
    "wasm/integrity.json",
    "wasm/runtime/*.mjs",
    "wasm/runtime/*.txt",
    "bin/flatsql.mjs",
    "cpp/include/flatsql/flatsql.h",
    "docs/API-3.12.md",
    "README.md",
    "LICENSE",
    "cpp/include/flatsql/flatsql_io.h"
  ],
  "scripts": {
    "build": "node scripts/build-runtime.mjs && node scripts/build-demo.mjs",
    "build:wasm": "bash scripts/build-wasm.sh",
    "test": "node scripts/ci-unified-e2e.mjs",
    "test:e2e": "bash scripts/ci-e2e.sh",
    "test:browser": "node scripts/ci-browser-e2e.mjs",
    "serve": "vite docs --port 8081",
    "check:imports": "node scripts/check-wasm-imports.mjs",
    "check:integrity": "node scripts/write-integrity.mjs --check",
    "check:package": "node scripts/check-package.mjs",
    "check:types": "tsc --noEmit --skipLibCheck --target ES2022 --module NodeNext --moduleResolution NodeNext wasm/index.d.ts",
    "check:nav": "node scripts/check-sdn-stack-nav.mjs flatsql docs/index.html docs/assets/sdn-chrome/sdn-chrome.css",
    "prepublishOnly": "bash scripts/ci-e2e.sh --wasm-only"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DigitalArsenal/flatsql.git"
  },
  "homepage": "https://digitalarsenal.github.io/flatsql/",
  "bugs": {
    "url": "https://github.com/DigitalArsenal/flatsql/issues"
  },
  "keywords": [
    "flatbuffers",
    "sqlite",
    "sql",
    "database",
    "streaming",
    "binary",
    "zero-copy",
    "wasm",
    "webassembly",
    "query",
    "virtual-table",
    "spatial",
    "geospatial",
    "voronoi",
    "delaunay",
    "rtree",
    "space-data-module"
  ],
  "author": "Edgesource Corporation <tj@edgesource.com>",
  "license": "PolyForm-Noncommercial-1.0.0",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "flatc-wasm": "^26.1.32",
    "space-data-module-sdk": "0.8.24",
    "spacedatastandards.org": "1.256.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "esbuild": "0.21.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "flatsql": "bin/flatsql.mjs"
  }
}
